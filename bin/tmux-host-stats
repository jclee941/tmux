#!/usr/bin/env bash
# tmux-host-stats — environment-aware CPU/MEM/DISK/GPU for the status bar.
#
# Local pane            → jclee-dev CPU .. MEM .. DISK ..
# Pane ssh'd to a host  → <label> CPU .. MEM .. DISK .. [GPU ..]  (fetched via ssh)
#
# Labels: 192.168.50.220/youtube/vm-220 → jclee-prd, local → jclee-dev.
# Remote stats are cached for TTL seconds so a 1s status-interval does not
# hammer ssh. Output-only script: must always exit 0 (runs inside #()).
set -uo pipefail

TTL=5
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCAL_LABEL="${TMUX_LOCAL_LABEL:-jclee-dev}"
PROBE="${TMUX_PROBE:-$HOME/.tmux/bin/tmux-remote-sys-probe}"

# Usage: tmux-host-stats [--local|--remote <target>] [--compact] [--bare] [--field cpu|mem|disk|gpu] [--push <prefix>] [client_width]
# Default (no mode flag): auto-detect ssh/mosh in the current pane.
# A numeric argument is the tmux client width (passed as #{client_width} from
# the status format); below COMPACT_MIN_WIDTH the compact form is used.
COMPACT_MIN_WIDTH=120
compact=false
bare=false
mode=auto
remote_arg=""
next_is_target=false
field=""
next_is_field=false
push_prefix=""
next_is_prefix=false
for arg in "$@"; do
  if $next_is_prefix; then
    push_prefix="$arg"
    next_is_prefix=false
    continue
  fi
  if $next_is_field; then
    field="$arg"
    next_is_field=false
    continue
  fi
  if $next_is_target; then
    remote_arg="$arg"
    next_is_target=false
    continue
  fi
  case "$arg" in
    --compact) compact=true ;;
    --bare) bare=true ;;
    --local) mode=local ;;
    --remote) mode=remote; next_is_target=true ;;
    --field) next_is_field=true ;;
    --push) next_is_prefix=true ;;
    '' | *[!0-9]*) ;;
    *) ((arg < COMPACT_MIN_WIDTH)) && compact=true ;;
  esac
done

host_label() {
  case "$1" in
    192.168.50.220 | youtube | vm-220) printf 'jclee-prd' ;;
    192.168.50.200 | oc | vm-200)      printf 'jclee-dev' ;;
    *) printf '%s' "${1%%.*}" | tr '[:lower:]' '[:upper:]' ;;
  esac
}

# Destination of an ssh/mosh-client running in the current pane, if any.
remote_target() {
  local tty line
  tty="$(tmux display-message -p '#{pane_tty}' 2>/dev/null || true)"
  [[ -z "$tty" ]] && return 0
  # shellcheck disable=SC2009 # ps -t filters by pane tty; pgrep -t cannot show args
  line="$(ps -t "${tty#/dev/}" -o args= 2>/dev/null | grep -E '^(ssh|mosh-client)[[:space:]]' | head -n 1 || true)"
  [[ -z "$line" ]] && return 0

  local -a args=()
  read -ra args <<< "$line"
  local i tok
  for ((i = 1; i < ${#args[@]}; i++)); do
    tok="${args[i]}"
    case "$tok" in
      ssh | mosh-client) continue ;;
      -*)
        # Flags that consume the next token as their value
        case "$tok" in
          -b | -c | -D | -E | -e | -F | -I | -i | -J | -L | -l | -m | -O | -o | -p | -Q | -R | -S | -W | -w) ((i++)) ;;
        esac
        continue
        ;;
    esac
    printf '%s' "${tok#*@}"
    return 0
  done
}

# Fixed-width pad for stable status bar layout (3 chars: '  7', ' 82', '100', '  ?')
pad3() {
  if [[ "$1" =~ ^[0-9]+$ ]]; then printf '%3d' "$1"; else printf '  ?'; fi
}

print_stats() {
  local label="$1" cpu="$2" mem="$3" disk="$4" gpu="${5:-}"
  if [[ -n "$field" ]]; then
    case "$field" in
      cpu) printf '%s\n' "${cpu:-?}" ;;
      mem) printf '%s\n' "${mem:-?}" ;;
      disk) printf '%s\n' "${disk:-?}" ;;
      gpu) printf '%s\n' "${gpu:-?}" ;;
    esac
    return 0
  fi
  local prefix=""
  $bare || prefix="${label} "
  if $compact; then
    printf '%sC:%s M:%s D:%s' "$prefix" "$cpu" "$mem" "$disk"
    [[ -n "$gpu" ]] && printf ' G:%s' "$gpu"
  else
    printf '%sCPU:%s%% MEM:%s%% DISK:%s%%' "$prefix" "$(pad3 "$cpu")" "$(pad3 "${mem:-?}")" "$(pad3 "${disk:-?}")"
    [[ -n "$gpu" ]] && printf ' GPU:%s%%' "$(pad3 "$gpu")"
  fi
  printf '\n'
}

# Push metric values into global tmux options @<prefix>_<field> (raw, for
# arithmetic) and @<prefix>_<field>_p (pad3, for display) so status formats can
# style them via #{@<prefix>_<field>} without nested #().
push_field() {
  local v="${2:-?}"
  tmux set -g "@${push_prefix}_$1" "$v" 2>/dev/null || true
  tmux set -g "@${push_prefix}_$1_p" "$(pad3 "$v")" 2>/dev/null || true
}
push_stats() {
  push_field cpu "${1:-?}"
  push_field mem "${2:-?}"
  push_field disk "${3:-?}"
  push_field gpu "${4:-?}"
}

fetch_local() {
  local ttl_local=2 cache now mtime raw tmp_cache cpu mem disk gpu
  cache="${CACHE_DIR}/tmux-host-stats-local"
  raw=""
  now=$(date +%s)
  if [[ -f "$cache" ]]; then
    mtime=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if ((now - mtime < ttl_local)); then
      raw="$(cat "$cache" 2>/dev/null || true)"
    fi
  fi
  if [[ -z "$raw" ]]; then
    raw="$(bash "$PROBE" 2>/dev/null || true)"
    if [[ "$raw" =~ ^[0-9]+\ [0-9]+\ [0-9]+ ]]; then
      tmp_cache="${cache}.$$"
      if printf '%s\n' "$raw" > "$tmp_cache" 2>/dev/null; then
        mv -f "$tmp_cache" "$cache" 2>/dev/null || rm -f "$tmp_cache"
      else
        rm -f "$tmp_cache"
      fi
    fi
  fi
  read -r cpu mem disk gpu <<< "$raw"
  [[ -z "${cpu:-}" ]] && cpu='?'
  if [[ -n "$push_prefix" ]]; then
    push_stats "$cpu" "${mem:-?}" "${disk:-?}" "${gpu:-?}"
    return 0
  fi
  print_stats "$LOCAL_LABEL" "$cpu" "${mem:-?}" "${disk:-?}" "${gpu:-}"
}

fetch_remote() {
  local target="$1" label cache safe now mtime raw fresh cpu mem disk gpu
  label="$(host_label "$target")"
  safe="${target//[^A-Za-z0-9_.-]/_}"
  cache="${CACHE_DIR}/tmux-host-stats-${safe}"
  raw=""
  now=$(date +%s)

  if [[ -f "$cache" ]]; then
    mtime=$(stat -c %Y "$cache" 2>/dev/null || echo 0)
    if ((now - mtime < TTL)); then
      raw="$(cat "$cache" 2>/dev/null || true)"
    fi
  fi

  if [[ -z "$raw" ]]; then
    fresh="$(timeout 5 ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=accept-new "$target" bash -s < "$PROBE" 2>/dev/null || true)"
    if [[ "$fresh" =~ ^[0-9]+\ [0-9]+\ [0-9]+ ]]; then
      raw="$fresh"
      tmp_cache="${cache}.$$"
      if printf '%s\n' "$raw" > "$tmp_cache" 2>/dev/null; then
        mv -f "$tmp_cache" "$cache" 2>/dev/null || rm -f "$tmp_cache"
      else
        rm -f "$tmp_cache"
      fi
    elif [[ -f "$cache" ]]; then
      raw="$(cat "$cache" 2>/dev/null || true)" # stale fallback while ssh is down
    fi
  fi

  read -r cpu mem disk gpu <<< "$raw"
  if [[ -n "$push_prefix" ]]; then
    if [[ -z "${cpu:-}" ]]; then
      push_stats '?' '?' '?' '?'
    else
      push_stats "${cpu:-?}" "${mem:-?}" "${disk:-?}" "${gpu:-?}"
    fi
    return 0
  fi
  if [[ -z "${cpu:-}" ]]; then
    if [[ -n "$field" ]]; then
      printf '?\n'
    elif $bare; then
      if $compact; then
        printf 'OFF\n'
      else
        printf 'OFFLINE\n'
      fi
    elif $compact; then
      printf '%s OFF\n' "$label"
    else
      printf '%s OFFLINE\n' "$label"
    fi
    return 0
  fi
  print_stats "$label" "$cpu" "${mem:-?}" "${disk:-?}" "${gpu:-}"
}

case "$mode" in
  local)
    fetch_local
    ;;
  remote)
    if [[ -n "$remote_arg" ]]; then
      fetch_remote "$remote_arg"
    else
      fetch_local
    fi
    ;;
  auto)
    target="$(remote_target)"
    if [[ -n "$target" ]]; then
      fetch_remote "$target"
    else
      fetch_local
    fi
    ;;
esac
exit 0
