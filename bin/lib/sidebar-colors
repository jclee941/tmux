# sidebar-colors — Tokyo Night palette for the session sidebar.
# Sourced by bin/tmux-sidebar. NOT readonly: re-sourcing under set -e
# must not abort the caller with "readonly variable".
if [[ -z "${__TMUX_SIDEBAR_COLORS_LOADED:-}" ]]; then
  __TMUX_SIDEBAR_COLORS_LOADED=1
  C_RESET='\033[0m'
  C_BG='\033[48;2;26;27;38m'         # #1a1b26 night bg
  C_FG='\033[38;2;169;177;214m'       # #a9b1d6
  C_ACCENT='\033[38;2;61;89;161m'     # #3d59a1 accent
  C_ACTIVE='\033[1;38;2;192;202;245m' # #c0caf5 bright fg (bold)
  C_ACTIVE_BG='\033[48;2;41;46;66m'   # #292e42 visual bg (visible stripe)
  C_DIM='\033[38;2;59;66;97m'         # #3b4261 dim
  C_IDLE='\033[38;2;34;36;54m'        # #222436 night idle
  C_GREEN='\033[38;2;115;218;202m'    # #73daca teal
  C_PURPLE='\033[38;2;157;124;216m'   # #9d7cd8 purple
  C_BORDER='\033[38;2;34;36;54m'      # #222436 night border
  C_CYAN='\033[38;2;125;207;255m'     # #7dcfff
  C_YELLOW='\033[38;2;224;175;104m'   # #e0af68
fi
