#!/usr/bin/env bash
# tmux-opencode — create or attach to the 'opencode' session, rooted at $HOME
# Bound to the Home key (no prefix).

set -euo pipefail

SESSION_NAME="opencode"
WORK_DIR="${HOME}"

if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  tmux switch-client -t "=$SESSION_NAME"
else
  tmux new-session -d -s "$SESSION_NAME" -c "$WORK_DIR"
  tmux switch-client -t "=$SESSION_NAME"
fi
