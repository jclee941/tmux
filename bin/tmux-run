#!/usr/bin/env bash
# tmux-run — synchronous command runner: send a command to a tmux pane,
# block until it finishes, and exit with its real exit code.
#
# Usage:
#   tmux-run [OPTIONS] -- COMMAND...
#
#   -t TARGET   tmux target pane (session, session:window, or
#               session:window.pane). Default: new window in current session.
#   -w [NAME]   force a fresh new window (optional name).
#   -l LOGFILE  tee the command's combined output to LOGFILE (append).
#   -T SECONDS  timeout: signal failure with exit 124 if exceeded.
#   -k          kill the spawned window after completion (new-window only).
#   -q          quiet: suppress the status line (exit code is still real).
#   -h          help
#
# Mechanism: send-keys a wrapper that runs COMMAND as a group, captures its
# real exit code via $?, writes it to a temp rc file, then signals a unique
# `tmux wait-for` channel. tmux-run blocks on that channel and reads the rc
# file for the caller's exit code — productizing the hand-written pattern:
#   cmd | tee log; status=${PIPESTATUS[0]}; tmux wait-for -S chan

set -euo pipefail

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

TARGET=""
NEWWINDOW=0
WINNAME=""
LOGFILE=""
TIMEOUT=""
KILL_AFTER=0
QUIET=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t) TARGET="${2:?}"; shift 2 ;;
        -w)
            NEWWINDOW=1
            shift
            if [[ $# -gt 0 && "$1" != "--" && "$1" != -* ]]; then
                WINNAME="$1"; shift
            fi
            ;;
        -l) LOGFILE="${2:?}"; shift 2 ;;
        -T) TIMEOUT="${2:?}"; shift 2 ;;
        -k) KILL_AFTER=1; shift ;;
        -q) QUIET=1; shift ;;
        -h|--help) usage 0 ;;
        --) shift; break ;;
        -*) echo "tmux-run: unknown option: $1" >&2; usage 1 ;;
        *) echo "tmux-run: unexpected argument: $1 (command must follow --)" >&2; usage 1 ;;
    esac
done

CMD=("$@")
[[ ${#CMD[@]} -gt 0 ]] || { echo "tmux-run: no command given (use -- COMMAND...)" >&2; exit 1; }

command -v tmux >/dev/null 2>&1 || { echo "tmux-run: tmux not installed" >&2; exit 1; }
tmux list-sessions >/dev/null 2>&1 || { echo "tmux-run: tmux server not running" >&2; exit 1; }

[[ -z "$TARGET" ]] && NEWWINDOW=1

if [[ "$NEWWINDOW" -eq 1 ]]; then
    new_args=(new-window -d -P -F '#{session_name}:#{window_index}')
    [[ -n "$WINNAME" ]] && new_args+=(-n "$WINNAME")
    TARGET=$(tmux "${new_args[@]}") || { echo "tmux-run: failed to create new window" >&2; exit 1; }
fi

pane_id=$(tmux display-message -p -t "$TARGET" '#{pane_id}' 2>/dev/null || true)
[[ -n "$pane_id" ]] || { echo "tmux-run: no such tmux target: $TARGET" >&2; exit 1; }

rc_file=$(mktemp "${TMPDIR:-/tmp}/tmux-run-rc.XXXXXX")
channel="tmux-run-$$-$RANDOM"
trap 'rm -f "$rc_file"' EXIT

quoted_cmd=""
for arg in "${CMD[@]}"; do
    printf -v q '%q' "$arg"
    quoted_cmd+="$q "
done

if [[ -n "$LOGFILE" ]]; then
    wrapper="{ ${quoted_cmd}; } 2>&1 | tee -a $(printf '%q' "$LOGFILE"); ec=\${PIPESTATUS[0]}; printf '%s' \"\$ec\" > $(printf '%q' "$rc_file"); tmux wait-for -S $(printf '%q' "$channel")"
else
    wrapper="{ ${quoted_cmd}; }; ec=\$?; printf '%s' \"\$ec\" > $(printf '%q' "$rc_file"); tmux wait-for -S $(printf '%q' "$channel")"
fi

tmux send-keys -t "$TARGET" -- "$wrapper" Enter

wait_status=0
if [[ -n "$TIMEOUT" ]]; then
    timeout "$TIMEOUT" tmux wait-for "$channel" || wait_status=$?
else
    tmux wait-for "$channel" || wait_status=$?
fi

if [[ "$wait_status" -ne 0 ]]; then
    tmux send-keys -t "$TARGET" C-c 2>/dev/null || true
    [[ "$QUIET" -eq 1 ]] || echo -e "\033[31m✘ tmux-run: $TARGET timed out after ${TIMEOUT}s\033[0m" >&2
    exit 124
fi

exit_code=$(cat "$rc_file" 2>/dev/null || echo 1)

if [[ "$KILL_AFTER" -eq 1 && "$NEWWINDOW" -eq 1 ]]; then
    tmux kill-window -t "$TARGET" 2>/dev/null || true
fi

if [[ "$QUIET" -ne 1 ]]; then
    if [[ "$exit_code" -eq 0 ]]; then
        echo -e "\033[32m✔ tmux-run: $TARGET exited $exit_code\033[0m"
    else
        echo -e "\033[31m✘ tmux-run: $TARGET exited $exit_code\033[0m"
    fi
fi

exit "$exit_code"
