# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Comma-separated chat IDs allowed to control tmux.
# Get yours by messaging the bot then checking logs, or via @userinfobot.
# LEAVE EMPTY ONLY FOR LOCAL TESTING — empty = anyone can drive your tmux.
TELEGRAM_ALLOWED_CHATS=

# tmux server socket name (matches your systemd tmux-server -L value). "default" = none.
TMUX_SOCKET=default
TMUX_HOME=/home/jclee/.tmux

# Streaming tuning (>=1000ms to respect Telegram 1 msg/sec/chat)
STREAM_INTERVAL_MS=2000
STREAM_LINES=60
STREAM_MAX_CHARS=3500
# Auto-stop a stream after N idle ticks (0 = stream forever until /stop)
STREAM_IDLE_STOP_TICKS=0

# --- OpenCode native bridge ---
# OPENCODE_API_URL=http://127.0.0.1:4096
# STREAM_THROTTLE_MS=1000
# TELEGRAM_DRAFT_STREAMING=false
# BINDINGS_PATH=./data/bindings.json
